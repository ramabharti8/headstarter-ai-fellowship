PORT=3003
# Port 27018 matches docker-compose's host mapping for the mongo service (kept
# distinct from the video-conferencing-app project's Mongo on 27017 so both can
# run side by side). Use 27017 if you're running your own local MongoDB instead.
MONGO_URI=mongodb://localhost:27018/live_collaboration
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5174
NODE_ENV=development

# How often (ms) an in-memory document/whiteboard is flushed to MongoDB
PERSIST_INTERVAL_MS=5000

# How often (ms) an automatic version snapshot is taken for an actively-edited document
SNAPSHOT_INTERVAL_MS=120000
