# --- Embedding provider ---------------------------------------------------
# "auto" uses the first key that is set (openai -> gemini), else "fastembed" —
# a real, local, ONNX embedding model that needs NO API key (downloads once,
# ~130MB, then runs fully offline). Force one with "openai", "gemini",
# "fastembed" or "fake".
SS_PROVIDER=auto

# OpenAI (model: text-embedding-3-small, 1536 dims)
SS_OPENAI_API_KEY=

# Gemini — free tier (model: text-embedding-004, 768 dims)
SS_GEMINI_API_KEY=

# Force the offline hashed-vector embedder (no network, not real semantics).
# Only useful for tests/CI.
SS_FAKE_EMBED=0

# --- Storage ---------------------------------------------------------------
# Where the FAISS index + SQLite docstore live. Switching SS_PROVIDER changes
# the embedding dimension, which is incompatible with an existing index at
# this path — point SS_DATA_DIR elsewhere or delete it when you switch.
SS_DATA_DIR=./data
SS_COLLECTION=documents

# --- Search / index knobs ---------------------------------------------------
SS_DEFAULT_TOP_K=5
SS_MAX_TOP_K=50
SS_MAX_DOCUMENTS=50000
SS_MAX_DOC_CHARS=8000
SS_MAX_BATCH_SIZE=256

# --- API ---------------------------------------------------------------
# Set to require "Authorization: Bearer <key>" / "X-API-Key" on write/search
# endpoints. When set, the built-in rate limiter is disabled (callers trusted).
SS_API_KEY=

# Comma-separated allowed origins, or "*"
SS_CORS_ORIGINS=*

# Requests per client IP per minute (0 disables). Ignored when SS_API_KEY is set.
SS_RATE_LIMIT_PER_MIN=60

# Serve /docs, /redoc, /openapi.json (turn off for a public deployment)
SS_DOCS_ENABLED=true
