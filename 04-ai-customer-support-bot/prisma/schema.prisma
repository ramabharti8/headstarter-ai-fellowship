// AI Customer Support Bot — data model
// Multi-tenant: every tenant-owned row carries `orgId` and is always queried org-scoped.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models
// ---------------------------------------------------------------------------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  invitesSent   Invite[]     @relation("InviteInviter")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  plan          String         @default("free")
  systemPrompt  String         @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  invites       Invite[]
  apiKeys       ApiKey[]
  conversations Conversation[]
  documents     Document[]
  chunks        Chunk[]
  usageEvents   UsageEvent[]
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      Role         @default(MEMBER)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invite {
  id        String       @id @default(cuid())
  orgId     String
  email     String
  role      Role         @default(MEMBER)
  token     String       @unique
  invitedBy String
  expires   DateTime
  createdAt DateTime     @default(now())
  acceptedAt DateTime?
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter   User         @relation("InviteInviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId])
}

model ApiKey {
  id         String       @id @default(cuid())
  orgId      String
  name       String
  prefix     String // first 8 chars, shown in UI
  hashedKey  String       @unique // sha-256 of the full key
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  createdBy  String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

enum Channel {
  WEB
  API
  WIDGET
}

enum MessageRole {
  user
  assistant
  system
}

model Conversation {
  id             String    @id @default(cuid())
  orgId          String
  title          String    @default("New conversation")
  channel        Channel   @default(WEB)
  useKnowledge   Boolean   @default(true)
  endUserRef     String? // opaque id supplied by API/widget callers
  createdByUser  String? // set for WEB conversations
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([orgId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  promptTokens   Int?
  responseMs     Int?
  citations      Json? // [{ documentId, title, chunkIndex }]
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Knowledge base (RAG)
// ---------------------------------------------------------------------------

enum DocStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Document {
  id         String       @id @default(cuid())
  orgId      String
  title      String
  sourceType String // "txt" | "md" | "pdf"
  byteSize   Int
  status     DocStatus    @default(PENDING)
  error      String?
  chunkCount Int          @default(0)
  createdBy  String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chunks     Chunk[]

  @@index([orgId, createdAt])
}

model Chunk {
  id         String                       @id @default(cuid())
  documentId String
  orgId      String
  index      Int
  content    String                       @db.Text
  // Managed via raw SQL migration; dimension must match AI_EMBEDDING_DIM.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                     @default(now())
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  org        Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model UsageEvent {
  id             String       @id @default(cuid())
  orgId          String
  type           String // "chat_message" | "api_message" | "ingest"
  channel        Channel      @default(WEB)
  conversationId String?
  tokens         Int?
  latencyMs      Int?
  retrievedDocs  Int?
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}
