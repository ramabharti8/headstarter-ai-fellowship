# ---- Core ----
# Postgres with the pgvector extension. docker-compose provides one on 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_bot?schema=public"

# ---- Auth (Auth.js / NextAuth v5) ----
# Generate: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of the app. Required in production.
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- AI provider ----
# Default provider. One of: google | openai | anthropic | groq
AI_PROVIDER="google"
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
# Model overrides. Check current names at https://ai.google.dev/gemini-api/docs/models
AI_CHAT_MODEL="gemini-flash-lite-latest"
AI_EMBEDDING_MODEL="gemini-embedding-001"
# Must match the vector(N) column in prisma/schema.prisma. pgvector's HNSW index caps at 2000.
AI_EMBEDDING_DIM="768"

# Alternative providers (only needed if AI_PROVIDER points at them)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""

# ---- Observability (optional) ----
# Leave empty to disable Sentry.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ---- Limits ----
# Chat requests per rolling window, per org.
RATE_LIMIT_CHAT_PER_MINUTE="30"
# Public API (/api/v1) requests per minute, per API key.
RATE_LIMIT_API_PER_MINUTE="60"
# Max upload size for knowledge-base documents, bytes (default 5 MB).
MAX_UPLOAD_BYTES="5242880"
