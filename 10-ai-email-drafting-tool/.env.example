# --- AI provider ---------------------------------------------------------
# "auto" uses the first key that is set (openai -> groq), else the offline
# template-based drafter. Force one with "openai", "groq" or "fake".
EM_PROVIDER=auto

# OpenAI (default model: gpt-4o-mini)
EM_OPENAI_API_KEY=

# Groq — free, fast alternative (default model: openai/gpt-oss-20b)
EM_GROQ_API_KEY=

# Override the per-provider default model
EM_CHAT_MODEL=

# Force the offline template drafter (no network). Handy for CI / demos.
EM_FAKE_AI=0

# --- Drafting knobs ---------------------------------------------------------
EM_MAX_BULLETS=20
EM_MAX_BULLET_CHARS=300
EM_MAX_CONTEXT_CHARS=1000
EM_MAX_VARIANTS=3
EM_MAX_OUTPUT_TOKENS=900

# --- API ----------------------------------------------------------------
# Set to require "Authorization: Bearer <key>" / "X-API-Key" on /draft and
# /revise. When set, the built-in rate limiter is disabled (callers trusted).
EM_API_KEY=

# Comma-separated allowed origins, or "*"
EM_CORS_ORIGINS=*

# Requests per client IP per minute (0 disables). Ignored when EM_API_KEY is set.
EM_RATE_LIMIT_PER_MIN=30

# Serve /docs, /redoc, /openapi.json (turn off for a public deployment)
EM_DOCS_ENABLED=true
