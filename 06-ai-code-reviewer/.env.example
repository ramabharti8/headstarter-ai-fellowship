# --- AI provider ---------------------------------------------------------
# "auto" uses the first key that is set (openai -> groq), else the offline
# heuristic reviewer. Force one with "openai", "groq" or "fake".
CR_PROVIDER=auto

# OpenAI (default model: gpt-4o)
CR_OPENAI_API_KEY=

# Groq — free, fast alternative (default model: openai/gpt-oss-20b)
CR_GROQ_API_KEY=

# Override the per-provider default model
CR_CHAT_MODEL=

# Force the offline pattern-based reviewer (no network). Handy for CI / demos.
CR_FAKE_AI=0

# --- API ----------------------------------------------------------------
# Set to require "Authorization: Bearer <key>" / "X-API-Key" on /review.
# When set, the built-in rate limiter is disabled (callers are trusted).
CR_API_KEY=

# Comma-separated allowed origins, or "*"
CR_CORS_ORIGINS=*

# Requests per client IP per minute (0 disables). Ignored when CR_API_KEY is set.
CR_RATE_LIMIT_PER_MIN=20

# Serve /docs, /redoc, /openapi.json (turn off for a public deployment)
CR_DOCS_ENABLED=true

# Longest code accepted before truncation
CR_MAX_CODE_CHARS=20000

# Ceiling on the model's response. Raise if large files get truncated ("usable
# JSON" errors); lower to save tokens.
CR_MAX_OUTPUT_TOKENS=6000
