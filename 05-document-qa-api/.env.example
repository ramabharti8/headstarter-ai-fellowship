# Copy to .env and fill in ONE provider. All vars are prefixed QA_.

# Which model provider to use: auto | openai | groq | gemini | fake
#   auto  -> first provider below that has a key (openai, then groq, then gemini),
#            falling back to "fake" if none is set
#   fake  -> deterministic local embeddings + a stub answerer (no key, no network)
QA_PROVIDER=auto

# --- OpenAI (paid) -------------------------------------------------------
# https://platform.openai.com/api-keys   (needs billing credit)
QA_OPENAI_API_KEY=

# --- Groq (free, fast) -------------------------------------------------
# https://console.groq.com/keys   (free, no card). Chat only — embeddings run
# locally via fastembed (first run downloads a ~90 MB model, then cached).
QA_GROQ_API_KEY=

# --- Google Gemini (free tier) --------------------------------------
# https://aistudio.google.com/apikey   (free, no card). Chat + embeddings.
QA_GOOGLE_API_KEY=

# Optional: override the default model for the active provider
# QA_CHAT_MODEL=
# QA_EMBEDDING_MODEL=

# Force offline stub mode regardless of keys (used by tests / CI)
QA_FAKE_AI=0

# --- Access control (for public deployments) --------------------
# Leave blank for local/demo = no auth. When set, every endpoint except /health
# and the UI shell requires  Authorization: Bearer <key>  or  X-API-Key: <key>.
QA_API_KEY=
# Set to false on a public deploy to hide /docs, /redoc and /openapi.json.
QA_DOCS_ENABLED=true

# Abuse protection — applies ONLY when QA_API_KEY is unset (public deploy).
# A holder of QA_API_KEY bypasses all of these.
QA_RATE_LIMIT_PER_MIN=20      # requests per client IP per minute (0 = off)
QA_UPLOADS_PER_DAY_PER_IP=10  # (0 = off)
QA_MAX_DOCUMENTS=30           # total kept; oldest auto-deleted on new upload (0 = ∞)
QA_TRUST_FORWARDED=true       # read client IP from X-Forwarded-For (needed behind a proxy)

# --- Storage / tuning ----------------------------------------------
QA_DATA_DIR=data
QA_CHUNK_SIZE=1000
QA_CHUNK_OVERLAP=200
QA_RETRIEVAL_K=6           # chunks sent to the model; raise (10-12) for "summarise the whole doc" questions
QA_MAX_ANSWER_TOKENS=2000  # ceiling on answer / summary length
QA_SNIPPET_CHARS=500       # length of each source excerpt returned by /ask
QA_SUMMARY_MAX_CHUNKS=40   # /summarize caps chunks read (keeps it fast on free tiers)
QA_MAX_UPLOAD_MB=25
QA_CORS_ORIGINS=*
