# Copy to .env and fill in. All vars are prefixed QA_.

# Your OpenAI API key. Required unless QA_FAKE_AI=1.
QA_OPENAI_API_KEY=sk-...

# Models (defaults shown)
QA_CHAT_MODEL=gpt-4o-mini
QA_EMBEDDING_MODEL=text-embedding-3-small

# Demo / offline mode: deterministic local embeddings + stub answerer, no network.
# Great for interviews when you don't want to spend credits. Set to 1 to enable.
QA_FAKE_AI=0

# Where Chroma + the SQLite metadata db live (mounted as a volume in Docker).
QA_DATA_DIR=data

# Ingestion / retrieval tuning
QA_CHUNK_SIZE=1000
QA_CHUNK_OVERLAP=200
QA_RETRIEVAL_K=4
QA_MAX_UPLOAD_MB=25

# Comma-separated CORS origins ("*" allows all)
QA_CORS_ORIGINS=*
