# --- AI provider ---------------------------------------------------------
# "auto" uses the first key that is set (openai -> groq), else the offline
# skill-overlap heuristic. Force one with "openai", "groq" or "fake".
RS_PROVIDER=auto

# OpenAI (default model: gpt-4o)
RS_OPENAI_API_KEY=

# Groq — free, fast alternative (default model: openai/gpt-oss-20b)
RS_GROQ_API_KEY=

# Override the per-provider default model
RS_CHAT_MODEL=

# Force the offline heuristic screener (no network). Handy for CI / demos.
RS_FAKE_AI=0

# --- API ----------------------------------------------------------------
# Set to require "Authorization: Bearer <key>" / "X-API-Key" on /screen.
# When set, the built-in rate limiter is disabled (callers are trusted).
RS_API_KEY=

# Comma-separated allowed origins, or "*"
RS_CORS_ORIGINS=*

# Requests per client IP per minute (0 disables). Ignored when RS_API_KEY is set.
RS_RATE_LIMIT_PER_MIN=20

# Serve /docs, /redoc, /openapi.json (turn off for a public deployment)
RS_DOCS_ENABLED=true

# Longest resume / job-description text accepted before truncation
RS_MAX_RESUME_CHARS=20000
RS_MAX_JD_CHARS=8000

# Ceiling on the model's response. Raise if long resumes get truncated
# ("usable JSON" errors); lower to save tokens.
RS_MAX_OUTPUT_TOKENS=2000

# Reject an uploaded resume file larger than this (bytes)
RS_MAX_UPLOAD_BYTES=5242880
