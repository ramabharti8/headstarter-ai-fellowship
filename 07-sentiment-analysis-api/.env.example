# --- Model --------------------------------------------------------------
# A 3-class HF sequence-classification model (negative / neutral / positive).
SENT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest

# "auto" uses the real model when torch + transformers are installed, else the
# offline lexicon. Force one with "transformers" or "fake".
SENT_BACKEND=auto

# Force the offline lexicon backend (no downloads, no torch). Handy for CI/demos.
SENT_FAKE_MODEL=0

# "auto" -> cuda if available, else mps, else cpu. Or pin: cpu / cuda.
SENT_DEVICE=auto

# Max input length in model tokens; longer text is truncated (response flagged).
SENT_MAX_LENGTH=512

# --- Request limits ----------------------------------------------------
SENT_MAX_TEXT_CHARS=5000
SENT_MAX_BATCH_SIZE=128
SENT_INFER_BATCH_SIZE=32
SENT_CACHE_SIZE=1024

# --- API -------------------------------------------------------------------
# Set to require "Authorization: Bearer <key>" / "X-API-Key" on the analyze
# endpoints. When set, the built-in rate limiter is disabled (callers trusted).
SENT_API_KEY=

SENT_CORS_ORIGINS=*

# Requests per client IP per minute (0 disables). Ignored when SENT_API_KEY set.
SENT_RATE_LIMIT_PER_MIN=60

# Expose GET /metrics in Prometheus text format.
SENT_METRICS_ENABLED=true

# Serve /docs, /redoc, /openapi.json (turn off for a public deployment).
SENT_DOCS_ENABLED=true
