PORT=3004
MONGO_URI=mongodb://localhost:27019/realtime_notifications
REDIS_URL=redis://localhost:6380
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5175
NODE_ENV=development

# Comma-separated default topics offered in the UI. Users/senders can also use custom topic names.
DEFAULT_TOPICS=orders,alerts,marketing,system

# SMTP is optional. Leave unset to use the built-in console transport (emails are
# logged to the server console instead of actually sent) - useful for local/dev use
# and for demoing the "email channel" feature without needing real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SignalBox <notifications@example.com>"
